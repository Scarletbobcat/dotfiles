# macOS package list — installed via `scripts/install-mac.sh`.
# Run `brew bundle dump --file=scripts/Brewfile --force` to regenerate
# from currently-installed packages.

# Shell: prompt, plugins, smart cd
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"
brew "fzf-tab"
brew "zoxide"
brew "fzf"

# Modern CLI tools
brew "eza"
brew "fd"             # fast `find` replacement; required by snacks.nvim projects picker

# Terminal multiplexers (using both for now)
brew "tmux"
brew "zellij"

# Networking / remote access
brew "tailscale"     # headless daemon for Tailscale SSH (see scripts/setup-tailscale.sh)

# Dev tooling
brew "mise"
brew "gh"
brew "git"
brew "chezmoi"        # dotfiles manager (this very repo)
brew "jq"             # required by jackknife setup.sh
brew "lazygit"
brew "lazydocker"

# Multi-agent workflow stack (jackknife-related)
brew "dicklesworthstone/tap/ntm"
brew "dicklesworthstone/tap/bv"   # beads viewer (paired with `br`)
brew "dicklesworthstone/tap/ubs"  # Ultimate Bug Scanner

# UBS runtime and scanning dependencies (git and jq are listed above)
brew "bash"           # UBS requires Bash 4+; macOS ships Bash 3.2
brew "python"         # scanner helpers
brew "ripgrep"
brew "ast-grep"       # syntax-aware JavaScript/TypeScript scans

# Editors
brew "neovim"

# Terminal emulator
cask "ghostty"

# GUI editors
cask "visual-studio-code"

# AI coding assistants
cask "codex"          # CLI; Claude Code is installed via npm in install-mac.sh
